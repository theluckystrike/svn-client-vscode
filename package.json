{
  "name": "zovo-svn-client",
  "displayName": "SVN Client & Subversion Source Control (Commit, Blame, Log, Diff)",
  "description": "Free SVN client for VS Code that uses your own svn command line. Subversion source control with commit, update, diff, log, blame, branch, switch and merge, one svn status at a time, and nested working copies found once. No sign-in, no network of its own.",
  "version": "0.1.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1B1F2E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "svn",
    "subversion",
    "svn client",
    "subversion client",
    "tortoisesvn",
    "svn blame",
    "svn log",
    "svn diff",
    "svn commit",
    "svn update",
    "scm",
    "source control",
    "version control",
    "branch",
    "merge",
    "changelist",
    "shelve",
    "revision graph",
    "offline",
    "free"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:.svn",
    "workspaceContains:*/.svn",
    "workspaceContains:*/*/.svn",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "svn runs only from the PATH or the user-level zovoSvn.path setting; a workspace cannot point it at another program.",
      "restrictedConfigurations": [
        "zovoSvn.path"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "zovoSvn.checkout",
        "title": "Checkout...",
        "category": "SVN",
        "icon": "$(cloud-download)"
      },
      {
        "command": "zovoSvn.commit",
        "title": "Commit",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "zovoSvn.commitSelected",
        "title": "Commit Selected Files",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "zovoSvn.commitChangelist",
        "title": "Commit Changelist",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "zovoSvn.refresh",
        "title": "Refresh",
        "category": "SVN",
        "icon": "$(refresh)"
      },
      {
        "command": "zovoSvn.update",
        "title": "Update",
        "category": "SVN",
        "icon": "$(cloud-download)"
      },
      {
        "command": "zovoSvn.updateToRevision",
        "title": "Update to Revision...",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.cleanup",
        "title": "Cleanup",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.add",
        "title": "Add",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "zovoSvn.addAll",
        "title": "Add All Unversioned",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "zovoSvn.revert",
        "title": "Revert (Discard Changes)",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "zovoSvn.revertAll",
        "title": "Revert All",
        "category": "SVN",
        "icon": "$(discard)"
      },
      {
        "command": "zovoSvn.delete",
        "title": "Delete (svn delete)",
        "category": "SVN",
        "icon": "$(trash)"
      },
      {
        "command": "zovoSvn.ignore",
        "title": "Add to svn:ignore",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.resolve",
        "title": "Resolve Conflict...",
        "category": "SVN",
        "icon": "$(check)"
      },
      {
        "command": "zovoSvn.openChange",
        "title": "Open Changes",
        "category": "SVN",
        "icon": "$(diff)"
      },
      {
        "command": "zovoSvn.openFile",
        "title": "Open File",
        "category": "SVN",
        "icon": "$(go-to-file)"
      },
      {
        "command": "zovoSvn.openBase",
        "title": "Open BASE Version",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.addToChangelist",
        "title": "Move to Changelist...",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.removeFromChangelist",
        "title": "Remove from Changelist",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.showLog",
        "title": "Show Log (History)",
        "category": "SVN",
        "icon": "$(history)"
      },
      {
        "command": "zovoSvn.showFileLog",
        "title": "Show File History",
        "category": "SVN",
        "icon": "$(history)"
      },
      {
        "command": "zovoSvn.toggleBlame",
        "title": "Toggle Blame",
        "category": "SVN",
        "icon": "$(person)"
      },
      {
        "command": "zovoSvn.openLineRevision",
        "title": "Open Changes of This Line's Revision",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.openRevisionDiff",
        "title": "Open Changes of a Revision",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.switch",
        "title": "Switch to Branch or Tag...",
        "category": "SVN",
        "icon": "$(git-branch)"
      },
      {
        "command": "zovoSvn.createBranch",
        "title": "Create Branch...",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.createTag",
        "title": "Create Tag...",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.merge",
        "title": "Merge from Branch...",
        "category": "SVN",
        "icon": "$(git-merge)"
      },
      {
        "command": "zovoSvn.revisionGraph",
        "title": "Show Revision Graph",
        "category": "SVN",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "zovoSvn.shelve",
        "title": "Shelve Changes...",
        "category": "SVN",
        "icon": "$(archive)"
      },
      {
        "command": "zovoSvn.unshelve",
        "title": "Unshelve...",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.newChangelist",
        "title": "New Changelist...",
        "category": "SVN",
        "icon": "$(add)"
      },
      {
        "command": "zovoSvn.moveToChangelist",
        "title": "Move to Changelist...",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.rescan",
        "title": "Find Working Copies Again",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.installHelp",
        "title": "Install the svn Command Line...",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.showOutput",
        "title": "Show Output",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.openWalkthrough",
        "title": "Get Started",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.supportDeveloper",
        "title": "Support the developer",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.moreViewers",
        "title": "More free tools by Zovo",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.unlockWithSponsors",
        "title": "Unlock Zovo Pro with GitHub Sponsors",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.enterLicenseKey",
        "title": "Enter Zovo license key",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.getPro",
        "title": "Get Zovo Pro (USD 15 once, all Zovo tools)",
        "category": "SVN"
      },
      {
        "command": "zovoSvn.removeLicense",
        "title": "Remove Zovo license from this editor",
        "category": "SVN"
      }
    ],
    "menus": {
      "commandPalette": [
