        {
          "command": "zovoSvn.enterLicenseKey",
          "when": "zovoSvn.proEnabled"
        },
        {
          "command": "zovoSvn.getPro",
          "when": "zovoSvn.proEnabled"
        },
        {
          "command": "zovoSvn.removeLicense",
          "when": "zovoSvn.proEnabled"
        },
        {
          "command": "zovoSvn.openLineRevision",
